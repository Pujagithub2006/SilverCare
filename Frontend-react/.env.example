# Environment variables for React (Vite) frontend
# Copy this file to .env.local and fill in your real values (DO NOT commit .env or .env.local)

# Vite requires variables to start with VITE_ to be exposed to the client
# VITE_API_BASE_URL=http://localhost:8080/api
# VITE_THIRD_PARTY_API_KEY=your_key_here
