# ===================================================================
# SilverCare Spring Boot Backend Environment Variables
# Copy this file to .env or set these environment variables in Render/Docker
# ===================================================================

# 1. Server Configuration
PORT=8081

# 2. Live Twilio SMS & Emergency Call Credentials
# Get your Account SID, Auth Token, and Phone Number from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_actual_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18885550123
TWILIO_ENABLED=true

# 3. LLM AI API Keys (for Mitra Senior Care Assistant & Emergency Advisor)
# Google Gemini: Get free key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Llama-3: Get free key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI GPT: Get key from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# 4. Security & JWT Token Key
JWT_SECRET=SilverCareSecretKey2026ForJWTTokenGenerationMustBeAtLeast512BitsLongForHS512AlgorithmSecurity

# 5. Database Configuration (NEON POSTGRES DB)
# DATABASE_URL=YOUR_NEON_POSTGRES_DB_URL
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_postgres_password
