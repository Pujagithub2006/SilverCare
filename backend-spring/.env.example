# Environment variables for Spring Boot backend
# Copy this file to .env and fill in your real credentials (DO NOT commit .env)

# Server Port
# PORT=8081

# Twilio SMS / Emergency Call Credentials
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
# TWILIO_ENABLED=true

# AI / LLM API Keys
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# JWT Secret Key
# JWT_SECRET=your_512_bit_secret_key_here
